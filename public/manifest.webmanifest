{
  "name": "Habit Activity",
  "short_name": "Habits",
  "description": "Track your daily habits with contribution-style heatmaps.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0a0a0a",
